@page
@model IndexModel
@{
    ViewData["Title"] = "Strona Główna";
    ViewData["IsClientPage"] = true;
}

<section class="container text-center py-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <section role="alert" style="background-color: red !important;">
            @TempData["SuccessMessage"]
        </section>
    }

    <img src="../images/logo.png" alt="FixCar4Us" class="logo">
    <h4 class="text-motto">Profesjonalne usługi naprawy samochodów. Super, fajnie i kapitalnie. Normalnie petarda</h4>
    <br/>
    <section class="main-section">
        <a asp-page="/BookAppointment"><h3>Umów wizytę</h3></a>
        <span>Zarezerwuj termin w naszym warsztacie szybko i wygodnie.</span>
        <br/>
        <br/>
        <a asp-page="/MyVehicles/Index"><h3>Moje Pojazdy</h3></a>
        <span>Zarządzaj swoimi pojazdami i zgłaszaj ich naprawy.</span>
        <br/>
        <br/>
        <a asp-page="/RepairStatus/Index"><h3>Sprawdź status naprawy</h3></a>
        <span>Dowiedz się, na jakim etapie jest naprawa Twojego samochodu.</span>
        <br/>
        <br/>
        <a asp-page="/FleetBookAppointment"><h3>Umów wizytę flotową</h3></a>
        <span>Zarezerwuj wizyty dla Swoich aut z obniżoną ceną</span>
    </section>
    <br/>
    <section class="main-section">
        <a asp-page="/CustomerLogin">Logowanie</a>
        <span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
        <a asp-page="/ClientLogin">Rejestracja</a>
        <span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
        <a asp-page="/AdminLogin">Panel Pracownika</a>
    </section>
</section>
