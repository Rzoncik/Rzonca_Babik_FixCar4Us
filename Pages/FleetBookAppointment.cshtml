@page
@model Rzonca_Babik_FixCar4Us.Pages.FleetBookAppointmentModel
@{
    ViewData["Title"] = "Rezerwacja Grupowa (Flota)";
    ViewData["IsClientPage"] = true;
}

<section class="row justify-content-center">
        <section class="form">
            <h3>Serwisowanie Masowe (Panel Flotowy)</h3>
            <br/>
            <p>Zaznacz pojazdy, które chcesz umówić do serwisu i wybierz usługę dla każdego z nich.</p>

            @if (Model.IsSuccess)
            {
                <section class="alert">
                    <h4>Udało się!</h4>
                    <p>Zgłoszenia dla wszystkich zaznaczonych pojazdów zostały pomyślnie przyjęte. Skontaktujemy się z Tobą w celu ustalenia szczegółów terminów.</p>
                    
                    @if (Model.SuccessMessages.Any())
                    {
                        <section>
                            <h5>Szacowane wyceny i rabaty:</h5>
                            <ul>
                                @foreach (var msg in Model.SuccessMessages)
                                {
                                    <li>@Html.Raw(msg)</li>
                                }
                            </ul>
                        </section>
                    }

                    <hr>
                    <a asp-page="/MyVehicles/Index">Wróć do moich pojazdów</a>
                </section>
            }
            else
            {
                <section>
                    <section>
                        <form method="post">
                            <section asp-validation-summary="All"></section>

                            @if (Model.Vehicles.Count == 0)
                            {
                                <section>
                                    Brak pojazdów we flocie. Dodaj pojazd w zakładce <a asp-page="/MyVehicles/Index">Moje Pojazdy</a>.
                                </section>
                            }
                            else
                            {
                                <section>
                                    <table>
                                        <thead>
                                            <tr>
                                                <th></th>
                                                <th>Pojazd</th>
                                                <th>Nr rejestracyjny</th>
                                                <th>Wybór usługi dla pojazdu</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var v in Model.Vehicles)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="checkbox" name="SelectedVehicles" value="@v.Id" id="chk_@v.Id">
                                                    </td>
                                                    <td>
                                                        <label for="chk_@v.Id">@v.Model</label>
                                                    </td>
                                                    <td>
                                                        @v.LicensePlate
                                                    </td>
                                                    <td>
                                                        <select name="ServiceForVehicle_@v.Id">
                                                            <option value="">-- Wybierz usługę --</option>
                                                            @foreach (var item in Model.ServicesList)
                                                            {
                                                                <option value="@item.Value">@item.Text</option>
                                                            }
                                                        </select>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </section>
                                <br/>
                                <section>
                                    <label asp-for="ReportedIssues">Krótki opis usterki / Uwagi (opcjonalnie)</label>
                                    <br/>
                                    <br/>
                                    <textarea asp-for="ReportedIssues" rows="3" placeholder="np. Stuka pod maską, proszę o sprawdzenie zawieszenia... (Opis zostanie dołączony do wszystkich wybranych pojazdów)"></textarea>
                                </section>
                                <br/>
                                <section>
                                    <button type="submit">
                                        Umów wybrane pojazdy
                                    </button>
                                </section>
                            }
                        </form>
                    </section>
                </section>
            }
            <br/>
            <a asp-page="/Index">Wróć na stronę główną</a>
        </section>
    </section>
</section>

@section Scripts {
    <script>
        // Prosty skrypt zaznaczający checkboxa jeśli wybrano usługę z dropdownu
        document.addEventListener('DOMContentLoaded', function() {
            var selects = document.querySelectorAll('select[name^="ServiceForVehicle_"]');
            selects.forEach(function(select) {
                select.addEventListener('change', function() {
                    if (this.value !== "") {
                        var tr = this.closest('tr');
                        var checkbox = tr.querySelector('input[type="checkbox"]');
                        checkbox.checked = true;
                    }
                });
            });
        });
    </script>
}
