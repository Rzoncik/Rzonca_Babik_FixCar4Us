@page
@model Rzonca_Babik_FixCar4Us.Pages.FleetBookAppointmentModel
@{
    ViewData["Title"] = "Rezerwacja Grupowa (Flota)";
    ViewData["IsClientPage"] = true;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h2 class="mb-4 text-center text-primary fw-bold">Serwisowanie Masowe (Panel Flotowy)</h2>
            <p class="text-center text-muted mb-5">Zaznacz pojazdy, które chcesz umówić do serwisu i wybierz usługę dla każdego z nich.</p>

            @if (Model.IsSuccess)
            {
                <div class="alert alert-success text-center shadow-sm p-5 border-0 rounded-4">
                    <h4 class="alert-heading display-6 mb-3">Udało się!</h4>
                    <p class="lead mb-4">Zgłoszenia dla wszystkich zaznaczonych pojazdów zostały pomyślnie przyjęte. Skontaktujemy się z Tobą w celu ustalenia szczegółów terminów.</p>
                    
                    @if (Model.SuccessMessages.Any())
                    {
                        <div class="text-start mt-4 mb-4">
                            <h5 class="fw-bold mb-3">Szacowane wyceny i rabaty:</h5>
                            <ul class="list-group">
                                @foreach (var msg in Model.SuccessMessages)
                                {
                                    <li class="list-group-item">@Html.Raw(msg)</li>
                                }
                            </ul>
                        </div>
                    }

                    <hr class="mb-4">
                    <a asp-page="/MyVehicles/Index" class="btn btn-success btn-lg px-5">Wróć do moich pojazdów</a>
                </div>
            }
            else
            {
                <div class="card shadow border-0 rounded-4">
                    <div class="card-body p-4 p-md-5">
                        <form method="post">
                            <div asp-validation-summary="All" class="text-danger mb-4"></div>

                            @if (Model.Vehicles.Count == 0)
                            {
                                <div class="alert alert-warning mb-5">
                                    Brak pojazdów we flocie. Dodaj pojazd w zakładce <a asp-page="/MyVehicles/Index">Moje Pojazdy</a>.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive mb-5">
                                    <table class="table table-hover align-middle border">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="text-center" style="width: 50px;">
                                                    <i class="bi bi-check-square"></i>
                                                </th>
                                                <th>Pojazd</th>
                                                <th>Nr rejestracyjny</th>
                                                <th>Wybór usługi dla pojazdu</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var v in Model.Vehicles)
                                            {
                                                <tr>
                                                    <td class="text-center">
                                                        <input class="form-check-input fs-5" type="checkbox" name="SelectedVehicles" value="@v.Id" id="chk_@v.Id">
                                                    </td>
                                                    <td>
                                                        <label class="form-check-label fw-bold d-block w-100" for="chk_@v.Id">@v.Model</label>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-secondary fs-6">@v.LicensePlate</span>
                                                    </td>
                                                    <td>
                                                        <select name="ServiceForVehicle_@v.Id" class="form-select bg-light border-0">
                                                            <option value="">-- Wybierz usługę --</option>
                                                            @foreach (var item in Model.ServicesList)
                                                            {
                                                                <option value="@item.Value">@item.Text</option>
                                                            }
                                                        </select>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="alert alert-info border-0 rounded-3 mb-4">
                                    <strong>Wskazówka:</strong> System przetworzy zlecenia tylko dla pojazdów zaznaczonych "ptaszkiem" (checkboxem). Jeśli dla zaznaczonego pojazdu nie wybierzesz usługi z listy, zgłoszenie to pominie wybór domyślnej usługi.
                                </div>

                                <div class="d-grid mt-4">
                                    <button type="submit" class="btn btn-primary btn-lg rounded-pill py-3 fw-bold shadow-sm">
                                        Umów wybrane pojazdy
                                    </button>
                                </div>
                            }
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Prosty skrypt zaznaczający checkboxa jeśli wybrano usługę z dropdownu
        document.addEventListener('DOMContentLoaded', function() {
            var selects = document.querySelectorAll('select[name^="ServiceForVehicle_"]');
            selects.forEach(function(select) {
                select.addEventListener('change', function() {
                    if (this.value !== "") {
                        var tr = this.closest('tr');
                        var checkbox = tr.querySelector('input[type="checkbox"]');
                        checkbox.checked = true;
                    }
                });
            });
        });
    </script>
}
