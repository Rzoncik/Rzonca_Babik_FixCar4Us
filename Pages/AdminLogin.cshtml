@page
@model Rzonca_Babik_FixCar4Us.Pages.AdminLoginModel
@{
    ViewData["Title"] = "Logowanie Pracownika";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-white text-center p-4 rounded-top-4">
                    <h3 class="mb-0 fw-bold">Panel Pracownika</h3>
                    <small>FixCar4Us</small>
                </div>
                <div class="card-body p-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Input.Email" class="form-label fw-bold"></label>
                            <input asp-for="Input.Email" class="form-control form-control-lg bg-light border-0" placeholder="nazwa@fixcar4us.pl" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Input.Password" class="form-label fw-bold"></label>
                            <input asp-for="Input.Password" class="form-control form-control-lg bg-light border-0" placeholder="••••••••" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark btn-lg rounded-pill fw-bold py-3 shadow-sm">Zaloguj się</button>
                        </div>
                        
                        <div class="text-center mt-4">
                            <a asp-page="/Index" class="text-decoration-none text-muted">Wróć na stronę główną</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
