@page
@model Rzonca_Babik_FixCar4Us.Pages.CustomersModel
@{
    ViewData["Title"] = "Klienci";
}

<section class="row justify-content-center">
    <section class="form form-wide">
    <h3>Klienci</h3>
        <a href="/Customers/Create">Dodaj klienta</a>
        <br/>
        <br/>
        <table>
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Imię i Nazwisko / Nazwa</th>
                    <th>Telefon</th>
                    <th>Email</th>
                    <th>Pojazdy (Historia)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td>@customer.Id</td>
                        <td>@customer.FirstName @customer.LastName</td>
                        <td>@customer.PhoneNumber</td>
                        <td>@customer.Email</td>

                        <td>
                            @if (customer.Vehicles.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var v in customer.Vehicles)
                                    {
                                        <li>@v.LicensePlate (@v.Model) - <a href="/Vehicles/Details?id=@v.Id">Naprawy</a></li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted">Brak aut</span>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Customers.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">Brak klientów w bazie. Dodaj nowego klienta!</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</section>
