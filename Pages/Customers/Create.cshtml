@page
@model Rzonca_Babik_FixCar4Us.Pages.Customers.CreateModel
@{
    ViewData["Title"] = "Dodaj Klienta";
}

<section class="row justify-content-center">
    <section class="form">
        <h3>Dodaj nowego klienta</h3>
        </br/>

        <form method="post">
            <section>
                <label asp-for="Customer.FirstName">Imię / Nazwa Firmy</label>
                <input asp-for="Customer.FirstName" placeholder="np. Jan / Auto-Pol Sp. z o.o." />
                <span asp-validation-for="Customer.FirstName"></span>
            </section>
            </br>
            <section>
                <label asp-for="Customer.LastName">Nazwisko</label>
                <input asp-for="Customer.LastName" placeholder="(Zostaw puste dla firmy)" />
                <span asp-validation-for="Customer.LastName"></span>
            </section>
            </br>
            <section>
                <label asp-for="Customer.PhoneNumber">Telefon (np. 123456789)</label>
                <input asp-for="Customer.PhoneNumber" type="number" />
                <span asp-validation-for="Customer.PhoneNumber" class="text-danger"></span>
            </section>
            </br>
            <section>
                <label asp-for="Customer.Email">Email</label>
                <input asp-for="Customer.Email" type="email" placeholder="email@przyklad.pl" />
                <span asp-validation-for="Customer.Email"></span>
            </section>
            </br>
            <section>
                <button type="submit">Zapisz klienta</button>
            </section>
        </form>
    </section>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
