@page
@model Rzonca_Babik_FixCar4Us.Pages.RepairStatus.IndexModel
@{
    ViewData["Title"] = "Status Naprawy";
    ViewData["IsClientPage"] = true;
}

<section class="row justify-content-center">
    <section class="form form-wide">
        <h3>Status naprawy</h3>
        <br/>

        <form method="get">
            <input type="text" asp-for="SearchString" placeholder="Szukaj (ID, status, model, opis...)"/>
            <br/>
            <br/>
            <button type="submit">Szukaj</button>
            <br/>
            <br/>
            @if (!string.IsNullOrEmpty(Model.SearchString))
            {
                <a asp-page="./Index">Wyczyść filtry</a>
            }
        </form>

        @if (TempData["SuccessMessage"] != null)
        {
            <section class="alert alert-success">
                @TempData["SuccessMessage"]
            </section>
        }

        @if (Model.CustomerOrders == null || Model.CustomerOrders.Count == 0)
        {
            <section class="alert">
                <h4 class="alert-heading">Brak aktywnych zgłoszeń</h4>
            </section>
        }
        else
        {
            <table>
                @foreach (var order in Model.CustomerOrders)
                {
                    <tr>
                        <th>Zlecenie #@order.Id<br/>@order.Status</th>
                        <td>@order.Vehicle?.Model (@order.Vehicle?.LicensePlate)</td>
                        <td><strong>Utworzono:</strong> @order.CreatedAt</td>
                        @if (!string.IsNullOrEmpty(order.CompletedAt))
                        {
                            <td><strong>Zakończono:</strong> @order.CompletedAt</td>
                        }
                        <td>
                            <strong>Opis:</strong><br />
                            @order.ReportedIssues
                        </td>

                        @if (order.Employee != null)
                        {
                            <td>
                                <strong>Opiekun zlecenia:</strong>
                                <span>@order.Employee.FirstName @order.Employee.LastName</span>
                                <br/>
                                <span>Nr. telefonu @order.Employee.PhoneNumber</span>
                            </td>
                        }
                            
                        @{
                            double servicesTotal = order.OrderServices.Sum(s => s.FinalPrice ?? 0);
                            double additionalFee = order.AdditionalFee;
                            double partsCost = order.OrderParts.Sum(p => (p.Quantity ?? 0) * (p.PriceAtTheTime ?? 0));
                            double laborCost = order.OrderServices.Sum(s => (s.LoggedHours ?? 0) * (s.Service?.BaseHourlyRate ?? 150.0));
                            double total = servicesTotal;
                        }
                            
                        @if (total > 0 || additionalFee > 0 || partsCost > 0 || laborCost > 0)
                        {
                            <td>
                                <span>Kosztorys:</span>
                                <ul>
                                    <li>
                                        <span>Robocizna (czas: @order.OrderServices.Sum(s => s.LoggedHours ?? 0)h):</span>
                                        <strong>@laborCost.ToString("C")</strong>
                                    </li>
                                    <li>
                                        <span>Części zamienne:</span>
                                        <strong>@partsCost.ToString("C")</strong>
                                    </li>
                                    @if (additionalFee > 0)
                                    {
                                        <li class="text-danger">
                                            <span>Wycena dodatkowa (@order.DifficultyDescription):</span>
                                            <strong>@additionalFee.ToString("C")</strong>
                                        </li>
                                    }
                                    @if ((laborCost + partsCost + additionalFee) > total)
                                    {
                                        <li class="text-success">
                                            <span>Rabat flotowy (15% od całości):</span>
                                            <strong>-@((laborCost + partsCost + additionalFee - total).ToString("C"))</strong>
                                        </li>
                                    }
                                </ul>
                            </td>
                        }
                            
                        @if (total > 0)
                        {
                            <td>
                                <span>Suma do zapłaty</span>
                                <h4>@total.ToString("C")</h4>
                            </td>
                        }
                            
                        @if (order.Status == "Zakończone")
                        {
                            <td>
                                <form method="post" asp-page-handler="Pay">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <button type="submit">
                                        <i></i>Opłać naprawę
                                    </button>
                                </form>
                            </td>
                        }
                        else if (order.Status == "Opłacone")
                        {
                            <td>
                                <button class="disabled">Opłacone</button>
                            </td>
                        }
                    </tr>
                }
            </table>
        }
        <br/>
        <a asp-page="/Index">Wróć na stronę główną</a>
    </section>
</section>