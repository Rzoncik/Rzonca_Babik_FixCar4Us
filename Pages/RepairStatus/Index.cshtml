@page
@model Rzonca_Babik_FixCar4Us.Pages.RepairStatus.IndexModel
@{
    ViewData["Title"] = "Status Naprawy";
    ViewData["IsClientPage"] = true;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="text-primary fw-bold">Sprawdź status naprawy</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm rounded-3 mb-4">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    @if (Model.CustomerOrders == null || Model.CustomerOrders.Count == 0)
    {
        <div class="alert alert-info text-center p-5 shadow-sm rounded-4">
            <h4 class="alert-heading mb-3">Brak aktywnych zgłoszeń</h4>
            <p class="mb-0">Nie masz jeszcze żadnych historii napraw. Przejdź do zakładki <a asp-page="/MyVehicles/Index">Moje Pojazdy</a> aby umówić wizytę.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var order in Model.CustomerOrders)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        <div class="card-header @(order.Status == "Zakończone" ? "bg-success text-white" : (order.Status == "Opłacone" ? "bg-dark text-white" : "bg-primary text-white")) p-3 rounded-top-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 fw-bold">Zlecenie #@order.Id</h5>
                                <span class="badge bg-light text-dark">@order.Status</span>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <h6 class="card-subtitle mb-3 text-muted">@order.Vehicle?.Model (@order.Vehicle?.LicensePlate)</h6>
                            <p class="card-text small mb-2"><strong>Utworzono:</strong> @order.CreatedAt</p>
                            @if (!string.IsNullOrEmpty(order.CompletedAt))
                            {
                                <p class="card-text small mb-2"><strong>Zakończono:</strong> @order.CompletedAt</p>
                            }
                            
                            <hr />
                            
                            <p class="card-text small text-muted mb-3" style="min-height: 40px;">
                                <strong>Opis:</strong><br />
                                @order.ReportedIssues
                            </p>

                            @if (order.Employee != null)
                            {
                                <div class="bg-primary bg-opacity-10 p-2 rounded mb-3 border border-primary border-opacity-25 shadow-sm">
                                    <strong class="text-primary small d-block mb-1"><i class="bi bi-person-workspace me-1"></i> Opiekun zlecenia:</strong>
                                    <div class="d-flex align-items-center mt-2">
                                        <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3 d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person-fill fs-5 text-primary"></i>
                                        </div>
                                        <div class="small">
                                            <div class="fw-bold text-dark fs-6">@order.Employee.FirstName @order.Employee.LastName</div>
                                            <div class="text-muted mt-1"><i class="bi bi-telephone-fill me-1"></i> @order.Employee.PhoneNumber</div>
                                        </div>
                                    </div>
                                </div>
                            }
                            
                            @{
                                double servicesTotal = order.OrderServices.Sum(s => s.FinalPrice ?? 0);
                                double additionalFee = order.AdditionalFee;
                                double partsCost = order.OrderParts.Sum(p => (p.Quantity ?? 0) * (p.PriceAtTheTime ?? 0));
                                double laborCost = order.OrderServices.Sum(s => (s.LoggedHours ?? 0) * (s.Service?.BaseHourlyRate ?? 150.0));
                                double total = servicesTotal;
                            }
                            
                            @if (total > 0 || additionalFee > 0 || partsCost > 0 || laborCost > 0)
                            {
                                <div class="bg-light p-3 rounded-3 mb-3">
                                    <span class="d-block text-dark fw-bold mb-2 border-bottom pb-2">Kosztorys:</span>
                                    <ul class="list-unstyled mb-0 small">
                                        <li class="d-flex justify-content-between mb-1">
                                            <span>Robocizna (czas: @order.OrderServices.Sum(s => s.LoggedHours ?? 0)h):</span>
                                            <strong>@laborCost.ToString("C")</strong>
                                        </li>
                                        <li class="d-flex justify-content-between mb-1">
                                            <span>Części zamienne:</span>
                                            <strong>@partsCost.ToString("C")</strong>
                                        </li>
                                        @if (additionalFee > 0)
                                        {
                                            <li class="d-flex justify-content-between mb-1 text-danger">
                                                <span>Wycena dodatkowa (@order.DifficultyDescription):</span>
                                                <strong>@additionalFee.ToString("C")</strong>
                                            </li>
                                        }
                                        @if ((laborCost + partsCost + additionalFee) > total)
                                        {
                                            <li class="d-flex justify-content-between mb-1 text-success fw-bold">
                                                <span>Rabat flotowy (15% od całości):</span>
                                                <strong>-@((laborCost + partsCost + additionalFee - total).ToString("C"))</strong>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            
                            @if (total > 0)
                            {
                                <div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-3 text-center border border-primary">
                                    <span class="d-block text-primary small text-uppercase fw-bold">Suma do zapłaty</span>
                                    <h4 class="mb-0 text-dark fw-bold">@total.ToString("C")</h4>
                                </div>
                            }

                            @if (order.Status == "Zakończone")
                            {
                                <form method="post" asp-page-handler="Pay">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <button type="submit" class="btn btn-success w-100 fw-bold py-2 shadow-sm">
                                        <i class="bi bi-credit-card me-2"></i>Opłać naprawę
                                    </button>
                                </form>
                            }
                            else if (order.Status == "Opłacone")
                            {
                                <button class="btn btn-outline-secondary w-100 fw-bold py-2 disabled">
                                    <i class="bi bi-check2-all me-2"></i>Opłacone
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
