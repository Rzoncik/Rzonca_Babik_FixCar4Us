@page
@model Rzonca_Babik_FixCar4Us.Pages.BookAppointmentModel
@{
    ViewData["Title"] = "Umów wizytę";
    ViewData["IsClientPage"] = true;
}

<section class="row justify-content-center">
    <section class="form">
        @if (Model.IsSuccess)
        {
            <p>Twoje zgłoszenie zostało przyjęte.</p>
        }
        else
        {
        <form method="post">
            <h3>Wybierz pojazd</h3>
            <br/>
            @if (Model.PreSelectedVehicle != null)
            {
                <h3><strong>Umawiasz:</strong> @Model.PreSelectedVehicle.Model @Model.PreSelectedVehicle.LicensePlate</h3>
                <input type="hidden" asp-for="SelectedVehicleId" />
            }
            else if (Model.Vehicles.Count == 0)
            {
                <section>
                    Nie masz żadnych pojazdów na Swoim koncie. Dodaj pojazd w zakładce <a asp-page="/MyVehicles/Index">Moje Pojazdy</a> przed umówieniem wizyty.
                </section>
            }
            else
            {
                <span asp-validation-for="SelectedVehicleId" class="text-danger d-block mb-2"></span>
                <table>
                    <thead>
                        <tr>
                            <th></th>
                            <th>Pojazd</th>
                            <th>Nr rej.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Vehicles)
                        {
                            <tr>
                                <td>
                                    <input type="radio" asp-for="SelectedVehicleId" value="@v.Id" id="vehicle_@v.Id" required>
                                </td>
                                <td><label for="vehicle_@v.Id">@v.Model</label></td>
                                <td><label for="vehicle_@v.Id">@v.LicensePlate</label></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <br/>
            <h3>Wybór usługi</h3>
            <label asp-for="SelectedServiceId">Wybierz usługę do wykonania</label>
            <select asp-for="SelectedServiceId" asp-items="Model.ServicesList" required>
                <option value="">Wybierz usługę z listy</option>
            </select>
            <br/>
            <br/>
            <label asp-for="ReportedIssues">Krótki opis usterki / Uwagi (opcjonalnie)</label>
            <textarea asp-for="ReportedIssues" rows="3""></textarea>
            <br/>
            <br/>
            <button type="submit">Wyślij zgłoszenie</button>
        </form>
            }
        <br/>
        <a asp-page="/Index">Wróć na stronę główną</a>
    </section>
</section>
