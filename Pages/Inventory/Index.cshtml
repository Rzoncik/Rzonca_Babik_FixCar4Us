@page
@model Rzonca_Babik_FixCar4Us.Pages.Inventory.IndexModel
@{
    ViewData["Title"] = "Magazyn części";
}

<section class="row justify-content-center">
    <section class="form form-wide">
        <h3>Magazyn części</h3>
        <br/>
        <a asp-page="./Create">Dodaj nową część</a>
        <br/>
        <br/>

        <form method="get">
            <input type="text" asp-for="SearchString" placeholder="Szukaj po nazwie części lub numerze seryjnym"/>
            <br/>
            <br/>
            <button type="submit">Szukaj</button>
            <br/>
            <br/>
            @if (!string.IsNullOrEmpty(Model.SearchString))
            {
                <a asp-page="./Index">Wyczyść filtry</a>
                <br/>
                <br/>
            }
        </form>
        @if (TempData["ErrorMessage"] != null)
        {
            <section class="alert">
                <span>@TempData["ErrorMessage"]</span>
            </section>
            <br/>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <section class="alert">
                <span>@TempData["SuccessMessage"]</span>
            </section>
            <br/>
        }
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nazwa części</th>
                    <th>Numer seryjny</th>
                    <th>Stan na magazynie</th>
                    <th>Dodaj część wpisując liczbę<br/>(Ujemna wartość usuwa część)</th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Parts != null && Model.Parts.Any())
                {
                    @foreach (var part in Model.Parts)
                    {
                        <tr>
                            <td>@part.Id</td>
                            <td>@part.Name</td>
                            <td>@part.PartNumber</td>
                            <td>
                                @if (part.StockQuantity > 0)
                                {
                                    <span>@part.StockQuantity szt.</span>
                                }
                                else
                                {
                                    <span>Brak</span>
                                }
                            </td>
                            <td>
                                <form method="post" asp-page-handler="UpdateStock">
                                    <input type="hidden" name="PartId" value="@part.Id" />
                                    <section style="display: flex; gap: 0.5rem;">
                                        <input type="number" name="QuantityChange" required />
                                        <button type="submit">Aktualizuj</button>
                                    </section>
                                </form>
                            </td>
                            <td>
                                <form method="post" asp-page-handler="Delete">
                                    <input type="hidden" name="partId" value="@part.Id" />
                                    <button type="submit" onclick="return confirm('Czy na pewno chcesz usunąć tę część?');">Usuń</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">Brak części w bazie danych.</td>
                    </tr>
                }
            </tbody>
        </table>
        <br/>
        <a asp-page="/Index">Wróć na stronę główną</a>
    </section>
</section>
