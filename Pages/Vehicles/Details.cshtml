@page
@model Rzonca_Babik_FixCar4Us.Pages.Vehicles.DetailsModel
@{
    ViewData["Title"] = "Historia Pojazdu";
}

<section class="row justify-content-center">
    <section class="form form-wide">
        <h3>Historia pojazdu: <span>@Model.Vehicle.LicensePlate</span></h3>
        <br/>
        <span>Model: </span>
        <span>@Model.Vehicle.Model</span>
        <br/>
        <span>VIN: </span>
        <span>@(string.IsNullOrEmpty(Model.Vehicle.VIN) ? "Brak danych" : Model.Vehicle.VIN)</span>
        <br/>
        <span>Przebieg: </span>
        <span>@Model.Vehicle.Mileage km</span>
        <br/>
        <br/>
        @if (Model.RepairOrders.Any())
        {
            @foreach (var repair in Model.RepairOrders)
            {
                <table>
                    <tr>
                        <th>Data wpisu</th>
                        <th>Zgłoszenie i opis usterki</th>
                        <th>Wymienione części:</th>
                        <th>Status</th>
                    </tr>
                    <tr>
                        <td>
                            @repair.CreatedAt
                        </td>
                        <td>
                            @repair.ReportedIssues
                        </td>
                        <td>
                            @if (repair.OrderParts != null && repair.OrderParts.Any())
                            {
                                <ul>
                                    @foreach (var part in repair.OrderParts)
                                    {
                                        <li>
                                            <span>@part.Part?.Name <span>(ilość: @part.Quantity)</span></span>
                                            <span>@part.PriceAtTheTime zł / szt.</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <section>Brak przypisanych części w tym zleceniu.</section>
                            }
                        </td>
                        <td>
                            @repair.Status
                            @if (!string.IsNullOrEmpty(repair.CompletedAt))
                            {
                                <span>Zakończono: @repair.CompletedAt</span>
                            }
                        </td>
                    </tr>
                </table>
            <br/>
            <br/>
            }
        }
        else
        {
            <section>Brak historii napraw dla tego pojazdu.</section>
        }
        <br/>
        <section>
            <h3>Badania techniczne</h3>
            @if (Model.TechnicalInspections.Any())
            {
                <section>
                    @foreach (var inspection in Model.TechnicalInspections)
                    {
                        <section>
                            <section>
                                <h6>Data: @inspection.InspectionDate.ToShortDateString()</h6>
                                @if (inspection.Result != null && (inspection.Result.Contains("Pozytywny") || inspection.Result.Contains("Zaliczone") || inspection.Result.Contains("OK")))
                                {
                                    <span>@inspection.Result</span>
                                }
                                else
                                {
                                    <span>@(inspection.Result ?? "Brak danych")</span>
                                }
                            </section>
                            <p>@inspection.Comments</p>
                        </section>
                    }
                </section>
            }
            else
            {
                <section>Pojazd nie posiada zapisanych badań technicznych.</section>
            }
        </section>
        <br/>
        <a asp-page="./Vehicles">Powrót do bazy pojazdów</a>
    </section>
</section>
