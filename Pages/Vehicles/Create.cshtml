@page
@model Rzonca_Babik_FixCar4Us.Pages.Vehicles.CreateModel
@{
    ViewData["Title"] = "Dodaj Pojazd";
}

<section class="row justify-content-center">
    <section class="form">
        <h3>Dodaj nowy pojazd</h3>
        <br/>
        <form method="post">
            <label asp-for="Vehicle.LicensePlate">Numer Rejestracyjny</label>
            <input asp-for="Vehicle.LicensePlate" placeholder="np. KR 12345" />
            <span asp-validation-for="Vehicle.LicensePlate" class="text-danger"></span>
            <br/>
            <br/>

            <label asp-for="Vehicle.VIN">VIN</label>
            <input asp-for="Vehicle.VIN" placeholder="17 znaków" />
            <span asp-validation-for="Vehicle.VIN" class="text-danger"></span>
            <br/>
            <br/>

            <label asp-for="Vehicle.Model">Model pojazdu</label>
            <input asp-for="Vehicle.Model" placeholder="np. Toyota Corolla" />
            <span asp-validation-for="Vehicle.Model" class="text-danger"></span>
            <br/>
            <br/>

            <label asp-for="Vehicle.Mileage">Przebieg (km)</label>
            <input asp-for="Vehicle.Mileage" type="number" placeholder="np. 150000" />
            <span asp-validation-for="Vehicle.Mileage" class="text-danger"></span>
            <br/>
            <br/>

            <button type="submit">Zapisz pojazd</button>
            <br/>
            <br/>
            <a href="/Vehicles/Vehicles">Powrót do bazy pojazdów </a>
        </form>
    </section>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
