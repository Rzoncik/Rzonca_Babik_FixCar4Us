@page
@model VehiclesModel
@{
    ViewData["Title"] = "Pojazdy";
}

<section class="row justify-content-center">
    <section class="form form-wide">
        <h1>Pojazdy</h1>
        <br/>
        <a href="/Vehicles/Create">Dodaj pojazd</a>
        <br/>
        <br/>
        <table>
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Rejestracja</th>
                    <th>VIN</th>
                    <th>Model</th>
                    <th>Przebieg</th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Model.Vehicles)
                {
                    <tr>
                        <td>@vehicle.Id</td>
                        <td>@vehicle.LicensePlate</td>
                        <td>@(string.IsNullOrEmpty(vehicle.VIN) ? "Brak" : vehicle.VIN)</td>
                        <td>@vehicle.Model</td>
                        <td>@vehicle.Mileage km</td>
                        <td>
                            <a href="/Vehicles/Details?id=@vehicle.Id">Historia</a>
                        </td>
                    </tr>
                }
                @if (Model.Vehicles.Count == 0)
                {
                    <tr>
                        <td colspan="6">Brak pojazdów w bazie. Dodaj nowy pojazd!</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</section>
