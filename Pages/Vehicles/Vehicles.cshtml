@page
@model VehiclesModel
@{
    ViewData["Title"] = "Baza Pojazdów";
}

<div class="text-center mb-4">
    <span>Baza Pojazdów i historia</span>
</div>

<!-- Główny obszar roboczy, zgodnie z prośbą -->
<main class="border rounded p-4  shadow-sm" style="min-height: 400px;">
    <!-- Miejsce na zawartość do wpisania przez użytkownika -->
    <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="display-4 mb-0">Baza pojazdów</h1>
    <a href="/Vehicles/Create" class="btn btn-primary">Dodaj pojazd</a>
</div>

<!-- Tutaj będzie tabela, którą uzupełnimy później -->
<div class="border rounded p-4 bg-light" style="min-height: 400px;">
    <!-- Tabela z listą pojazdów -->
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Rejestracja</th>
                <th>VIN</th>
                <th>Model</th>
                <th>Przebieg</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vehicle in Model.Vehicles)
            {
                <tr>
                    <td>@vehicle.Id</td>
                    <td>@vehicle.LicensePlate</td>
                    <td>@(string.IsNullOrEmpty(vehicle.VIN) ? "Brak" : vehicle.VIN)</td>
                    <td>@vehicle.Model</td>
                    <td>@vehicle.Mileage km</td>
                    <td>
                        <a href="/Vehicles/Details?id=@vehicle.Id" class="btn btn-sm btn-info text-white">Historia</a>
                    </td>
                </tr>
            }
            @if (Model.Vehicles.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">Brak pojazdów w bazie. Dodaj nowy pojazd!</td>
                </tr>
            }
        </tbody>
    </table>
</div>

</main>
