@page
@model Rzonca_Babik_FixCar4Us.Pages.RepairHistory.IndexModel
@{
    ViewData["Title"] = "Historia Zleceń";
}

<section class="row justify-content-center">
    <section class="form form-wide">
        <h3>Historia zleceń</h3>
        <br/>
        @if (Model.CompletedOrders.Count == 0)
        {
            <div>
                <h4>Brak zleceń w historii</h4>
                <p>Historia napraw jest pusta. Kiedy zlecenia zmienią status na "Zakończone" lub "Opłacone", pojawią się tutaj.</p>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Klient</th>
                        <th>Pojazd (Nr rej.)</th>
                        <th>Data przyjęcia</th>
                        <th>Data zakończenia</th>
                        <th>Status</th>
                        <th>Mechanik</th>
                        <th>Zgłoszone uwagi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.CompletedOrders)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>
                                @if (order.Vehicle?.Customer != null)
                                {
                                    <span>@order.Vehicle.Customer.FirstName @order.Vehicle.Customer.LastName</span>
                                }
                                else
                                {
                                    <span>Brak danych</span>
                                }
                                
                                @if (order.IsFleet == 1)
                                {
                                    <span>Flota</span>
                                }
                            </td>
                            <td>
                                @if (order.Vehicle != null)
                                {
                                    <strong>@order.Vehicle.Model</strong><br />
                                    <span>@order.Vehicle.LicensePlate</span>
                                }
                                else
                                {
                                    <span>Brak przypisanego pojazdu</span>
                                }
                            </td>
                            <td>@order.CreatedAt</td>
                            <td>@order.CompletedAt</td>
                            <td>
                                <span>@order.Status</span>
                            </td>
                            <td>
                                @if (order.Employee != null)
                                {
                                    <div><strong>@order.Employee.FirstName @order.Employee.LastName</strong></div>
                                    <div>@order.Employee.PhoneNumber</div>
                                }
                                else
                                {
                                    <span>Brak</span>
                                }
                            </td>
                            <td>@order.ReportedIssues</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</section>
