@page
@model Rzonca_Babik_FixCar4Us.Pages.Catalog.IndexModel
@{
    ViewData["Title"] = "Katalog usług";
}

<section class="row justify-content-center">
    <section class="form form-wide">
        <h3>Katalog usług</h3>
        <br/>
        <table>
            <thead>
                <tr>
                    <th>Nazwa usługi (Kategoria)</th>
                    <th>Stawka za roboczogodzinę</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Services != null && Model.Services.Any())
                {
                    @foreach (var service in Model.Services)
                    {
                        <tr>
                            <td>@service.Name</td>
                            <td>
                                <span>@service.BaseHourlyRate zł/h</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3">Brak usług w bazie danych.</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</section>