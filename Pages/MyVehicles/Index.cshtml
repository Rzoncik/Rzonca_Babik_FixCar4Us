@page
@model Rzonca_Babik_FixCar4Us.Pages.MyVehicles.IndexModel
@{
    ViewData["Title"] = "Moje Pojazdy";
    ViewData["IsClientPage"] = true;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">Moje Pojazdy</h2>
        <div>
            @if (Model.IsFleet)
            {
                <a asp-page="/FleetBookAppointment" class="btn btn-warning me-2 fw-bold text-dark">Rezerwacja Grupowa (Flota)</a>
            }
            <a asp-page="./Create" class="btn btn-success">Dodaj nowy pojazd</a>
        </div>
    </div>

    @if (Model.Vehicles.Count == 0)
    {
        <div class="alert alert-info">
            Nie masz jeszcze żadnych dodanych pojazdów. Kliknij przycisk "Dodaj nowy pojazd", aby zacząć.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Marka i model</th>
                                <th>Nr rejestracyjny</th>
                                <th>VIN</th>
                                <th>Przebieg (km)</th>
                                <th class="text-end">Akcje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Vehicles)
                            {
                                <tr>
                                    <td class="align-middle fw-bold">@item.Model</td>
                                    <td class="align-middle"><span class="badge bg-secondary">@item.LicensePlate</span></td>
                                    <td class="align-middle text-muted">@(string.IsNullOrEmpty(item.VIN) ? "-" : item.VIN)</td>
                                    <td class="align-middle">@item.Mileage</td>
                                    <td class="text-end align-middle">
                                        <a asp-page="/BookAppointment" asp-route-vehicleId="@item.Id" class="btn btn-sm btn-primary">Zgłoś naprawę</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
