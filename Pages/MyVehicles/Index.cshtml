@page
@model Rzonca_Babik_FixCar4Us.Pages.MyVehicles.IndexModel
@{
    ViewData["Title"] = "Moje Pojazdy";
    ViewData["IsClientPage"] = true;
}

@if (Model.Vehicles.Count == 0)
{
    <section>
        <br/>
        <br/>
        <span>Nie masz jeszcze żadnych dodanych pojazdów. Kliknij <a asp-page="/MyVehicles/Create">dodaj pojazd</a> aby rozpocząć.</span>
    </section>
}
else
{
    <section class="row justify-content-center">
        <section class="form">
            <h3>Moje pojazdy</h3>
            <br/>
            <table>
                <thead>
                    <tr>
                        <th>Marka i model</th>
                        <th>Nr rejestracyjny</th>
                        <th>VIN</th>
                        <th>Przebieg (km)</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Vehicles)
                    {
                        <tr>
                            <td>@item.Model</td>
                            <td>@item.LicensePlate</td>
                            <td>@(string.IsNullOrEmpty(item.VIN) ? "-" : item.VIN)</td>
                            <td>@item.Mileage</td>
                            <td>
                                <a asp-page="/BookAppointment" asp-route-vehicleId="@item.Id">Zgłoś naprawę</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <br/>
            <a asp-page="/MyVehicles/Create">Dodaj nowy pojazd</a>
            <br/>
            <br/>
            <a asp-page="/Index">Wróć na stronę główną</a>
        </section>
    </section>
}
