@page
@model Rzonca_Babik_FixCar4Us.Pages.MyVehicles.CreateModel
@{
    ViewData["Title"] = "Dodaj Pojazd";
    ViewData["IsClientPage"] = true;
}

<section class="row justify-content-center">
    <section class="form">
        <h3>Dodaj nowy pojazd</h3>
        <br/>
        <form method="post">
            <label asp-for="NewVehicle.LicensePlate">Numer rejestracyjny</label>
            <input asp-for="NewVehicle.LicensePlate" required />
            <span asp-validation-for="NewVehicle.LicensePlate" class="text-danger"></span>
            <br/>
            <br/>

            <label asp-for="NewVehicle.Model">Marka i model</label>
            <input asp-for="NewVehicle.Model" required />
            <span asp-validation-for="NewVehicle.Model" class="text-danger"></span>
            <br/>
            <br/>

            <label asp-for="NewVehicle.VIN">Numer VIN (opcjonalnie)</label>
            <input asp-for="NewVehicle.VIN" />
            <span asp-validation-for="NewVehicle.VIN" class="text-danger"></span>
            <br/>
            <br/>

            <label asp-for="NewVehicle.Mileage">Przebieg (km)</label>
            <input asp-for="NewVehicle.Mileage" type="number" />
            <span asp-validation-for="NewVehicle.Mileage" class="text-danger"></span>
            <br/>
            <br/>

            <button type="submit">Zapisz pojazd</button>
            <br/>
            <br/>
            <a asp-page="./Index">Anuluj</a>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
