@page
@model Rzonca_Babik_FixCar4Us.Pages.MyVehicles.CreateModel
@{
    ViewData["Title"] = "Dodaj Pojazd";
    ViewData["IsClientPage"] = true;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h3 class="mb-0">Dodaj nowy pojazd</h3>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="NewVehicle.LicensePlate" class="form-label fw-bold">Numer rejestracyjny</label>
                                <input asp-for="NewVehicle.LicensePlate" class="form-control form-control-lg bg-light border-0 text-uppercase" required />
                                <span asp-validation-for="NewVehicle.LicensePlate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewVehicle.Model" class="form-label fw-bold">Marka i model</label>
                                <input asp-for="NewVehicle.Model" class="form-control form-control-lg bg-light border-0" placeholder="np. Ford Focus" required />
                                <span asp-validation-for="NewVehicle.Model" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewVehicle.VIN" class="form-label fw-bold">Numer VIN (opcjonalnie)</label>
                                <input asp-for="NewVehicle.VIN" class="form-control form-control-lg bg-light border-0 text-uppercase" />
                                <span asp-validation-for="NewVehicle.VIN" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewVehicle.Mileage" class="form-label fw-bold">Przebieg (km)</label>
                                <input asp-for="NewVehicle.Mileage" type="number" class="form-control form-control-lg bg-light border-0" />
                                <span asp-validation-for="NewVehicle.Mileage" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-5">
                            <a asp-page="./Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">Anuluj</a>
                            <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-sm">Zapisz pojazd</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
