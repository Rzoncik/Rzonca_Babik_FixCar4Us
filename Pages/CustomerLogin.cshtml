@page
@model Rzonca_Babik_FixCar4Us.Pages.CustomerLoginModel
@{
    ViewData["Title"] = "Logowanie";
    ViewData["IsClientPage"] = true;
}

<section class="row justify-content-center">
    <section class="form">
        <h3>Logowanie</h3>
        <form method="post">
            <section asp-validation-summary="ModelOnly" class="text-danger mb-3"></section>
            <label asp-for="Input.Email"></label>
            <br/>
            <input asp-for="Input.Email" type="email" />
            <br/>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
            <br/>
            <label asp-for="Input.Password"></label>
            <br/>
            <input asp-for="Input.Password" />
            <br/>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
            <br/>
            <button type="submit">Zaloguj się</button>
        </form>
        <br/>
        <small>Nie masz konta? <a asp-page="/ClientLogin">Zarejestruj się</a></small>
        <br/>
        <br/>
        <a asp-page="/Index">Wróć na stronę główną</a>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
