@page
@model Rzonca_Babik_FixCar4Us.Pages.ClientLoginModel
@{
    ViewData["Title"] = "Rejestracja";
    ViewData["IsClientPage"] = true;
}

<section class="row justify-content-center">
    <section class="form">
        <h3>Rejestracja</h3>
        <form method="post">
            <label asp-for="Input.FirstName"></label>
            <br/>
            <input asp-for="Input.FirstName" />
            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            <br/>
            <label asp-for="Input.LastName"></label>
            <br/>
            <input asp-for="Input.LastName" />
            <span asp-validation-for="Input.LastName" class="text-danger"></span>
            <br/>
            <label asp-for="Input.PhoneNumber"></label>
            <br/>
            <input asp-for="Input.PhoneNumber" type="number" />
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            <br/>
            <label asp-for="Input.Email"></label>
            <br/>
            <input asp-for="Input.Email" type="email" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
            <br/>
            <label asp-for="Input.Password"></label>
            <br/>
            <input asp-for="Input.Password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
            <br/>
            <label asp-for="Input.ConfirmPassword"></label>
            <br/>
            <input asp-for="Input.ConfirmPassword" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            <br/>
            <br/>
            <button type="submit">Zarejestruj się</button>
        </form>
        <br/>
        <small>Masz już konto? <a asp-page="/CustomerLogin">Zaloguj się</a></small>
        <br/>
        <br/>
        <a asp-page="/Index">Wróć na stronę główną</a>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
