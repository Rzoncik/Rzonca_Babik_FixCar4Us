<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - FixCar4Us</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Rzonca_Babik_FixCar4Us.styles.css" asp-append-version="true"/>
</head>
<body>
<header>

@if (ViewData["IsClientPage"] is bool isClient && isClient)
{
}
else
{
    <nav class="navbar navbar-expand-sm navbar-light border-bottom">
        <ul class="navbar-nav flex-grow-1 gap-2">
            <li>
                <a asp-area="" asp-page="/Index">Strona Główna</a>
            </li>
            <li>
                <a asp-area="" asp-page="/Vehicles/Vehicles">Pojazdy</a>
            </li>
            <li>
                <a asp-area="" asp-page="/Customers/Customers">Klienci</a>
            </li>
            <li>
                <a asp-area="" asp-page="/Catalog/Index">Usługi</a>
            </li>
            <li>
                <a asp-area="" asp-page="/Inventory/Index">Części</a>
            </li>
            <li>
                <a asp-area="" asp-page="/MechanicPanel/Index">Panel Mechanika</a>
            </li>
            <li>
                <a asp-area="" asp-page="/RepairHistory/Index">Historia Zleceń</a>
            </li>
        </ul>
    </nav>
}

</header>
<section class="container">
    <main role="main">
        @RenderBody()
    </main>
</section>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>