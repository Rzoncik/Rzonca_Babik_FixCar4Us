<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Rzonca_Babik_FixCar4Us</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Rzonca_Babik_FixCar4Us.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">FixCar4Us</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex">
                <ul class="navbar-nav flex-grow-1 gap-2">
                    <li class="nav-item">
                        <a class="btn btn-outline-primary" asp-area="" asp-page="/Vehicles/Vehicles">Baza pojazdów</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-success" asp-area="" asp-page="/Customers/Customers">Kartoteka klientów</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-secondary" asp-area="" asp-page="/Catalog/Index">Katalog części i usług</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-warning" asp-area="" asp-page="/Inventory/Index">Zarządzanie magazynem</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-info" asp-area="" asp-page="/Calendar/Index">Kalendarz przyjęć</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - Rzonca_Babik_FixCar4Us - <a asp-area="" asp-page="/Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>