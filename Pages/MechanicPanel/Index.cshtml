@page
@model Rzonca_Babik_FixCar4Us.Pages.MechanicPanel.IndexModel
@{
    ViewData["Title"] = "Panel Mechanika";
}

<section class="row justify-content-center">
    <section class="form form-wide">
        <h3>Panel Mechanika</h3>
        <div asp-validation-summary="All" style="color: red; font-weight: bold; margin-bottom: 15px;"></div>
        <br/>
        @if (Model.ActiveOrders != null && Model.ActiveOrders.Any())
        {
            @foreach (var order in Model.ActiveOrders)
            {
                <table>
                    <thead>
                        <tr>
                            <th>Zlecenie</th>
                            <th>Auto</th>
                            <th>Zgłoszone usterki</th>
                            <th>Wybrana usługa</th>
                            <th>Przypisany Mechanik</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>#@order.Id</td>
                            <td>
                                @(order.Vehicle?.LicensePlate ?? "Brak") | Status: @order.Status
                            </td>
                            <td>@(order.ReportedIssues ?? "Brak opisu usterki")</td>
                            <td>@(order.OrderServices?.FirstOrDefault()?.Service?.Name ?? "Nie określono")</td>
                            <td>
                                @if (order.Employee != null)
                                {
                                    <span>@order.Employee.FirstName @order.Employee.LastName Nr telefonu: @order.Employee.PhoneNumber</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
                <br/>

                @if (order.Status == "Oczekujące na termin" || order.Status == "Nowe")
                {
                    <form method="post" asp-page-handler="Schedule">
                        <input type="hidden" name="SelectedOrderId" value="@order.Id" />
                                    
                        <label>Planowany początek</label>
                        <input type="datetime-local" asp-for="PlannedStart" required />
                        <label>Planowany koniec</label>
                        <input type="datetime-local" asp-for="PlannedEnd" required />
                        <label>Stanowisko pracy</label>
                        <select asp-for="SelectedWorkstationId" asp-items='(SelectList)ViewData["WorkstationsList"]'  required>
                            <option value="">Wybierz stanowisko</option>
                        </select>
                        <label>Wymagane narzędzie</label>
                        <select asp-for="SelectedToolId" asp-items='(SelectList)ViewData["ToolsList"]' >
                            <option value="">Brak narzędzia</option>
                        </select>
                        <label>Mechanik (Wymagane)</label>
                        <select asp-for="SelectedEmployeeId" asp-items='(SelectList)ViewData["EmployeesList"]' required>
                            <option value="">Wybierz pracownika</option>
                        </select>

                        <button type="submit">
                            Zaplanuj termin
                        </button>
                    </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="AdvanceStage">
                                    <input type="hidden" name="SelectedOrderId" value="@order.Id" />
                                    
                                    @if (order.Status == "Zamawianie części")
                                    {
                                        <label>Zamawiana Część (opcjonalnie)</label>
                                        <br/>
                                        <br/>
                                        <select name="PartIdToConsume" asp-items="Model.PartsList">
                                            <option value="-1">-- Brak (nie zamawiano) --</option>
                                        </select>
                                        <label>Ilość sztuk</label>
                                        <input type="number" name="QuantityToConsume" value="1" min="1" />
                                        <br/>
                                        <br/>
                                        <input type="checkbox" id="IsReplacementPart_@order.Id" name="IsReplacementPart">
                                        <label for="IsReplacementPart_@order.Id">
                                            Część zamienna (zastosuj 50% rabatu na cenę katalogową)
                                        </label>
                                        <br/>
                                        <br/>
                                        <button type="submit">
                                            Zamów i przejdź do naprawy
                                        </button>
                                        <br/>
                                        <br/>
                                    }
                                    else if (order.Status == "W naprawie")
                                    {
                                        <button type="submit">
                                            Zatwierdź pracę i przejdź do wyceny
                                        </button>
                                        <br/>
                                        <br/>
                                    }
                                    else if (order.Status == "Wycena dodatkowa")
                                    {
                                        <label>Opis utrudnień (np. trudny dostęp, urwana śruba)</label>
                                        <br/>
                                        <br/>
                                        <textarea name="DifficultyDescription"></textarea>
                                        <br/>
                                        <br/>
                                        <label>Dodatkowa opłata (PLN)</label>
                                        <br/>
                                        <br/>
                                        <input type="number" name="AdditionalFee" value="0" step="0.01" />
                                        <br/>
                                        <br/>
                                        <button type="submit">Zakończ naprawę</button>
                                        <br/>
                                        <br/>
                                    }
                                    else
                                    {
                                            <button type="submit">Przejdź do kolejnego etapu</button>
                                            <br/>
                                            <br/>
                                            <br/>
                                    }
                                </form>

                                @if (order.Status != "Oczekujące na termin" && order.Status != "Przyjęte" && order.Status != "Zakończone" && order.Status != "Opłacone" && order.Status != "Zaplanowane")
                                {
                                    <form method="post" asp-page-handler="RollbackStage">
                                        <input type="hidden" name="SelectedOrderId" value="@order.Id" />
                                        <button type="submit">Cofnij do poprzedniego etapu</button>
                                    </form>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                }
                            }
            }
        }
        else
        {
            <h4>Brak aktywnych zleceń!</h4>
            <p>Wszystkie samochody są naprawione albo warsztat jest pusty. Dobra robota!</p>
        }
        <br/>
        <br/>
        <h3>Kalendarz Warsztatu</h3>
        <section id="mechanicCalendar"></section>
    </section>
</section>

@section Scripts {
    <!-- FullCalendar CSS and JS -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/pl.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('mechanicCalendar');

            // Formatowanie wydarzeń z danych przekazanych z backendu
            var eventsData = [
                @foreach (var ev in Model.CalendarEvents)
                {
                    <text>
                    {
                        title: '@Html.Raw(ev.Title)',
                        start: '@ev.Start',
                        end: '@ev.End',
                        color: '@ev.Color'
                    },
                    </text>
                }
            ];

            var calendar = new FullCalendar.Calendar(calendarEl, {
                locale: 'pl',
                initialView: 'timeGridWeek',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                slotMinTime: '07:00:00',
                slotMaxTime: '19:00:00',
                allDaySlot: false,
                events: eventsData,
                eventDidMount: function(info) {
                    // Dodanie tooltipa z pełną nazwą
                    info.el.setAttribute('title', info.event.title);
                }
            });

            calendar.render();
        });
    </script>
}
