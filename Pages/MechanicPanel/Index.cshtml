@page
@model Rzonca_Babik_FixCar4Us.Pages.MechanicPanel.IndexModel
@{
    ViewData["Title"] = "Panel Mechanika";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-bold text-danger">Panel Mechanika</h1>
            <p class="text-muted">Jedno kliknięcie dzięki wzorcowi <b>Facade</b>, inteligentne przejścia dzięki <b>State</b>, i powiadomienia dzięki <b>Observer</b>.</p>
        </div>
    </div>

    <div class="row">
        @if (Model.ActiveOrders != null && Model.ActiveOrders.Any())
        {
            @foreach (var order in Model.ActiveOrders)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-danger border-top border-4">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Zlecenie #@order.Id</h5>
                            <h6 class="card-subtitle mb-3 text-muted">
                                Auto: @(order.Vehicle?.LicensePlate ?? "Brak") 
                                | Status: <span class="badge bg-warning text-dark">@order.Status</span>
                            </h6>
                            <p class="card-text mb-4">
                                <strong>Zgłoszone usterki:</strong><br />
                                @(order.ReportedIssues ?? "Brak opisu usterki")
                            </p>

                            <form method="post" asp-page-handler="AdvanceStage">
                                <input type="hidden" asp-for="SelectedOrderId" value="@order.Id" />
                                
                                <div class="row g-2 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">ID Wykonywanej Usługi</label>
                                        <input type="number" asp-for="ServiceId" class="form-control form-control-sm" required placeholder="Naciśnij 1 dla testów" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Przepracowane Godziny</label>
                                        <input type="number" step="0.5" asp-for="LoggedHours" class="form-control form-control-sm" required />
                                    </div>
                                </div>
                                
                                <div class="row g-2 mb-4 bg-light p-2 rounded">
                                    <div class="col-md-8">
                                        <label class="form-label small fw-bold">ID Zużytej Części (opcjonalnie)</label>
                                        <input type="number" asp-for="PartIdToConsume" class="form-control form-control-sm" placeholder="np. 1" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Ilość sztuk</label>
                                        <input type="number" asp-for="QuantityToConsume" class="form-control form-control-sm" value="0" />
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-danger w-100 fw-bold">
                                    Zatwierdź pracę i przejdź do następnego etapu
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-success text-center shadow-sm">
                    <h4>Brak aktywnych zleceń!</h4>
                    <p>Wszystkie samochody są naprawione albo warsztat jest pusty. Dobra robota!</p>
                </div>
            </div>
        }
    </div>
</div>
